lectric / 1000) * total_range_km * electricity_cost_per_kWh\n","    energy_cost_hybrid_fuel = energy_consumption_hybrid_eVTOL_fuel * total_range_km * fuel_cost_per_liter\n","    maintenance_cost_hybrid = initial_cost_hybrid_eVTOL * maintenance_cost_percent_hybrid / annual_operation_hours * total_range_km / average_speed_km_h\n","    depreciation_cost_hybrid = initial_cost_hybrid_eVTOL / (vehicle_lifespan * annual_operation_hours * average_speed_km_h)\n","    total_cost_per_range_hybrid = energy_cost_hybrid_electric + energy_cost_hybrid_fuel + maintenance_cost_hybrid + depreciation_cost_hybrid + battery_replacement_cost_hybrid\n","\n","    # Costs per Passenger Mile\n","    cost_per_passenger_mile_electric = (total_cost_per_range_electric / (total_range_km * km_to_miles)) / passengers\n","    cost_per_passenger_mile_hybrid = (total_cost_per_range_hybrid / (total_range_km * km_to_miles)) / passengers\n","\n","    return cost_per_passenger_mile_electric, cost_per_passenger_mile_hybrid\n","\n","# Example\n","cost_per_passenger_mile_electric, cost_per_passenger_mile_hybrid = calculate_cost_per_passenger_mile(\n","    electricity_cost_per_kWh=0.9,  # USD\n","    saf_cost_per_gallon=10,  # USD\n","    avgas_cost_per_gallon=3.5,  # USD\n","    energy_consumption_electric_eVTOL=200,  # Wh per km\n","    energy_consumption_hybrid_eVTOL_electric=150,  # Wh per km\n","    energy_consumption_hybrid_eVTOL_fuel=0.8,  # liters per km\n","    battery_cost_per_kWh=200,  # USD\n","    maintenance_cost_percent_electric=0.015,\n","    maintenance_cost_percent_hybrid=0.025,\n","    initial_cost_electric_eVTOL=1_200_000,  # USD\n","    initial_cost_hybrid_eVTOL=1_500_000,  # USD\n","    vehicle_lifespan=10,  # years\n","    annual_operation_hours=500,\n","    average_speed_km_h=100,\n","    total_range_km=200)\n","\n","print(f\"Cost per Passenger Mile for Electric eVTOL: ${cost_per_passenger_mile_electric:.2f}\")\n","print(f\"Cost per Passenger Mile for Hybrid eVTOL: ${cost_per_passenger_